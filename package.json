{
  "name": "aleetreny-portfolio",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm validate:repo && pnpm lint && pnpm typecheck && pnpm test",
    "validate:repo": "node scripts/validate-repo.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "content:build": "node scripts/content/build-fixtures.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "db:verify": "node scripts/db/verify.mjs",
    "db:owner": "node scripts/db/create-owner.mjs",
    "db:export": "node scripts/db/export-public.mjs",
    "db:import": "node scripts/db/import-public.mjs",
    "storage:export": "node scripts/storage/export-assets.mjs",
    "storage:import": "node scripts/storage/import-assets.mjs",
    "storage:verify-live": "node scripts/storage/verify-live.mjs",
    "neon:plan": "neon config plan",
    "neon:deploy": "neon deploy",
    "portability:verify": "node scripts/verify-portability.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1102.0",
    "@aws-sdk/s3-request-presigner": "3.1102.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@neondatabase/neon-js": "0.6.2-beta",
    "dotenv": "17.2.3",
    "hono": "4.13.0",
    "jose": "6.2.8",
    "pg": "8.22.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@neon/config": "0.13.2",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "neon": "2.43.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
