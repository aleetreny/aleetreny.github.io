# FRONTEND PUBLIC — copy this file to .env.local for local development.
# Never place private connection strings, API keys, or storage credentials in VITE_* variables.

# VITE_ENABLE_REMOTE_DATA — PUBLIC. "true" uses Neon; "false" uses committed demo fixtures.
# Obtain/configure: project operator. Environments: local, GitHub Actions Variables, production build.
VITE_ENABLE_REMOTE_DATA=false

# VITE_NEON_AUTH_URL — PUBLIC. Managed Better Auth HTTPS base URL for the selected Neon branch.
# Obtain: `neon env pull` / Neon Console. Environments: local, GitHub Actions Variable.
VITE_NEON_AUTH_URL=

# VITE_NEON_DATA_API_URL — PUBLIC. Neon Data API REST endpoint for the selected branch/database.
# Obtain: `neon env pull` / Neon Console. Environments: local, GitHub Actions Variable.
VITE_NEON_DATA_API_URL=

# VITE_STORAGE_FUNCTION_URL — PUBLIC. Deployed `storage` Neon Function origin, without trailing slash.
# Obtain: output of `neon deploy` / Neon Console. Environments: local, GitHub Actions Variable.
VITE_STORAGE_FUNCTION_URL=

# VITE_STORAGE_PUBLIC_BASE_URL — PUBLIC. Public-read bucket base URL, ending in `/portfolio-assets`.
# Obtain: Neon Storage endpoint + bucket name. Environments: local, GitHub Actions Variable.
VITE_STORAGE_PUBLIC_BASE_URL=

# VITE_TRANSLATE_FUNCTION_URL — PUBLIC, OPTIONAL. Origin of a Neon Function that
# holds a translation provider key server-side (DeepL free tier, or a
# LibreTranslate you host), for the `function` translator. Leave empty to use the
# keyless providers, which need nothing at all. The key itself never goes in a
# VITE_* variable — it lives in the Function's own environment.
VITE_TRANSLATE_FUNCTION_URL=

# VITE_HABITAT_RUNTIME_URL — PUBLIC, OPTIONAL. Origin of the read-only
# Cloudflare Worker serving the live habitat snapshot. Leave empty to keep the
# deterministic Genesis snapshot; provider keys remain private in the Worker.
VITE_HABITAT_RUNTIME_URL=

# SERVER/CLI PRIVATE — never expose these through Vite or commit their values.

# DATABASE_URL — PRIVATE. Direct or pooled Neon Postgres connection string used by migrations/scripts/function.
# Obtain: `neon env pull` / Neon Console Connect dialog. Environments: local secret, GitHub Actions Secret.
DATABASE_URL=

# NEON_API_KEY — PRIVATE. Personal/service API key used only to provision Neon from CI.
# Obtain: Neon Console > Account settings > API keys. Environments: local secret, GitHub Actions Secret.
NEON_API_KEY=

# NEON_PROJECT_ID — PUBLIC identifier. Target Neon project for automated provisioning.
# Obtain: Neon Console URL or `neon projects list`. Environments: local, GitHub Actions Variable.
NEON_PROJECT_ID=

# NEON_BRANCH — PUBLIC identifier/name. Branch targeted by deploy/migrations (for example `main`).
# Obtain: `neon branches list`. Environments: local, GitHub Actions Variable.
NEON_BRANCH=

# NEON_PROTECT_DEFAULT_BRANCH — PUBLIC policy flag. Keep "true" when the Neon plan supports protected branches.
# Obtain: Neon plan capabilities. Environments: local and GitHub Actions Variable. Use "false" only when the plan permits zero protected branches.
NEON_PROTECT_DEFAULT_BRANCH=true

# ALLOWED_ORIGINS — PUBLIC configuration. Comma-separated exact origins accepted by the storage function.
# Obtain: project domains. Environments: local and Neon Function environment via deploy workflow.
ALLOWED_ORIGINS=http://localhost:5173,https://aleetreny.github.io

# STORAGE_BUCKET — PUBLIC configuration. Bucket declared in neon.ts; normally keep the default.
# Obtain: repository architecture. Environments: local and Neon Function environment.
STORAGE_BUCKET=portfolio-assets

# OWNER_AUTH_USER_ID — PRIVATE operational identifier (not a credential). Neon Auth user's UUID to allowlist.
# Obtain: Neon Auth user table/Console after signup. Environments: local operator session only.
OWNER_AUTH_USER_ID=

# OWNER_EMAIL — PRIVATE personal data, optional metadata for the allowlist command.
# Obtain: portfolio owner. Environments: local operator session only; do not add to GitHub Variables.
OWNER_EMAIL=
